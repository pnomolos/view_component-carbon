<%= content_tag :div, **wrapper_attributes do %>
  <div class="<%= css_classes %>">
    <div class="cds--tab--list" role="tablist" aria-label="Tab navigation">
      <% tabs.each do |tab_data| %>
        <button role="tab"
                type="button"
                class="<%= class_names(button_css_classes(tab_data)) %>"
                data-action="click->carbon--tabs#select"
                data-carbon--tabs-target="tab"
                id="<%= tab_data.tab_id %>"
                aria-controls="<%= tab_data.panel_id %>"
                aria-selected="<%= tab_data.selected %>"
                <%= 'disabled' if tab_data.disabled %>
                tabindex="<%= tab_data.selected ? '0' : '-1' %>">
          <div class="cds--tabs__nav-item-label-wrapper">
            <span class="cds--tabs__nav-item-label"><%= tab_data.label %></span>
          </div>
        </button>
      <% end %>
    </div>
  </div>
  <% tabs.each do |tab_data| %>
    <div class="<%= class_names(panel_css_classes(tab_data)) %>"
         role="tabpanel"
         data-carbon--tabs-target="panel"
         id="<%= tab_data.panel_id %>"
         aria-labelledby="<%= tab_data.tab_id %>"
         <%= 'hidden' unless tab_data.selected %>>
      <%= tab_data.content %>
    </div>
  <% end %>
<% end %>
