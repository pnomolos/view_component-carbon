<li class="<%= css_classes %>" <%= tag.attributes(html_attributes) %>>
  <% if icon? %>
    <div class="<%= carbon_class('contained-list-item', 'icon') %>">
      <%= icon %>
    </div>
  <% end %>
  <%= tag.send(content_tag_name, **content_attributes) do %>
    <%= content %>
  <% end %>
  <% if action? %>
    <%= action %>
  <% end %>
</li>
