<div class="cds--tile-input">
  <input type="radio"
         class="cds--tile-input"
         id="<%= @input_id %>"
         <% if @name %>name="<%= @name %>"<% end %>
         value="<%= @value %>"
         tabindex="-1"
         <% if @checked %>checked<% end %>
         <% if @disabled %>disabled<% end %>>
  <label for="<%= @input_id %>"
         class="<%= label_css_classes %>"
         tabindex="0"
         data-action="click->carbon--tile-group#select keydown->carbon--tile-group#handleKeydown">
    <span class="cds--tile__checkmark"><%= checkmark_svg.html_safe %></span>
    <span class="cds--tile-content"><%= content %></span>
  </label>
</div>
