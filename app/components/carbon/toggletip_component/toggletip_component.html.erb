<span <%= tag.attributes(html_attributes) %>>
  <button class="cds--toggletip__button"
          type="button"
          aria-expanded="false"
          aria-controls="<%= toggletip_id %>"
          data-action="click->carbon--toggletip#toggle">
    <svg focusable="false" preserveAspectRatio="xMidYMid meet"
         xmlns="http://www.w3.org/2000/svg" fill="currentColor" width="16" height="16"
         viewBox="0 0 16 16" aria-hidden="true">
      <path d="M8,1C4.1,1,1,4.1,1,8s3.1,7,7,7s7-3.1,7-7S11.9,1,8,1z M8,14c-3.3,0-6-2.7-6-6s2.7-6,6-6s6,2.7,6,6S11.3,14,8,14z"></path>
      <circle cx="8" cy="11.5" r="0.8"></circle>
      <path d="M8,4.5C6.6,4.5,5.5,5.6,5.5,7H7c0-0.6,0.4-1,1-1s1,0.4,1,1c0,1-1.5,0.9-1.5,2.5V10h1.5l0-0.5 c0-1,1.5-0.9,1.5-2.5C9.5,5.6,8.4,4.5,8,4.5z"></path>
    </svg>
  </button>
  <span class="cds--popover" id="<%= toggletip_id %>">
    <span class="cds--popover-content cds--toggletip-content">
      <%= body %>
    </span>
    <span class="cds--popover-caret"></span>
  </span>
</span>
