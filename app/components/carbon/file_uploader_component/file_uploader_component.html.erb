<div class="<%= wrapper_classes %>">
  <% if @label_title %>
    <p class="cds--file--label"><%= @label_title %></p>
  <% end %>
  <% if @label_description %>
    <p class="<%= description_classes %>"><%= @label_description %></p>
  <% end %>
  <div class="cds--file" <%= tag.attributes(data: controller_data) %>>
    <% if @drop_container %>
      <button type="button"
              class="<%= drop_container_classes %>"
              aria-describedby="<%= @id %>-instructions"
              data-action="click->carbon--file-uploader#openFileDialog dragover->carbon--file-uploader#handleDragOver dragleave->carbon--file-uploader#handleDragLeave drop->carbon--file-uploader#handleDrop"
              <% if @disabled %>disabled<% end %>>
        <%= @button_label %>
      </button>
      <span id="<%= @id %>-instructions" class="cds--visually-hidden">
        Drag and drop files here or activate to browse and select files to upload
      </span>
      <label for="<%= @id %>" class="cds--visually-hidden"><%= @button_label %></label>
    <% else %>
      <label class="<%= button_classes %>" tabindex="0" for="<%= @id %>"
             role="button"
             data-action="keydown->carbon--file-uploader#handleLabelKeydown">
        <%= @button_label %>
      </label>
    <% end %>
    <input <%= tag.attributes(input_attributes) %>>
    <div class="cds--file-container" data-carbon--file-uploader-target="fileList">
      <% items.each do |item| %>
        <%= item %>
      <% end %>
    </div>
    <div aria-live="polite" aria-atomic="true" class="cds--visually-hidden" data-carbon--file-uploader-target="liveRegion">
    </div>
  </div>
</div>
