<thead>
  <tr>
    <% if @expandable %>
      <th class="cds--table-expand" data-carbon--data-table-target="expandAllHeader">
        <button class="cds--table-expand__button"
                type="button"
                aria-label="Expand all rows"
                data-action="click->carbon--data-table#toggleExpandAll">
          <svg focusable="false" preserveAspectRatio="xMidYMid meet"
               xmlns="http://www.w3.org/2000/svg" fill="currentColor"
               width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"
               class="cds--table-expand__svg">
            <path d="M11 8L6 13 5.3 12.3 9.6 8 5.3 3.7 6 3z"></path>
          </svg>
        </button>
      </th>
    <% end %>
    <% if @selectable %>
      <th class="cds--table-column-checkbox" scope="col">
        <% if @radio %>
          <span class="cds--visually-hidden">Select row</span>
        <% else %>
          <label class="cds--checkbox-label" for="<%= @table_id %>-select-all">
            <input type="checkbox"
                   id="<%= @table_id %>-select-all"
                   class="cds--checkbox"
                   aria-label="Select all rows"
                   data-action="change->carbon--data-table#toggleSelectAll"
                   data-carbon--data-table-target="selectAll">
            <span class="cds--checkbox-label-text cds--visually-hidden">Select all rows</span>
          </label>
        <% end %>
      </th>
    <% end %>
    <% cells.each do |cell| %>
      <%= cell %>
    <% end %>
  </tr>
</thead>
