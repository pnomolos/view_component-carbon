<div <%= tag.attributes(html_attributes) %>>
  <div <%= tag.attributes(container_attributes) %>>
    <% if header? %>
      <%= header %>
    <% end %>
    <% if body? %>
      <%= body %>
    <% end %>
    <% if footer? %>
      <%= footer %>
    <% end %>
    <% if @has_scrolling_content %>
      <div class="cds--modal-content--overflow-indicator"></div>
    <% end %>
  </div>
</div>
