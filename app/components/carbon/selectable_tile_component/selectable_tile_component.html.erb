<div class="<%= tile_css_classes %>"
     <%= tag.attributes(tile_html_attributes) %>>
  <span class="cds--tile__checkmark cds--tile__checkmark--persistent">
    <%= checkmark_icon %>
  </span>
  <div class="cds--tile-content">
    <%= content %>
  </div>
  <% if decorator? %>
    <%= decorator %>
  <% end %>
  <% if ai_label? %>
    <%= ai_label %>
  <% end %>
</div>
