<div class="<%= wrapper_classes %>">
  <div class="<%= number_classes %>" data-controller="carbon--number-input">
    <% if @label_text %>
      <label for="<%= @id %>" class="cds--label"><%= @label_text %></label>
    <% end %>
    <div class="cds--number__input-wrapper">
      <button <%= tag.attributes(button_attributes('down')) %>
              data-action="click->carbon--number-input#decrement"
              aria-label="Decrease number">−</button>
      <input <%= tag.attributes(input_attributes) %>
             data-carbon--number-input-target="input">
      <button <%= tag.attributes(button_attributes('up')) %>
              data-action="click->carbon--number-input#increment"
              aria-label="Increase number">+</button>
    </div>
    <% if @helper_text && !@invalid %>
      <div class="cds--form__helper-text"><%= @helper_text %></div>
    <% end %>
    <% if @invalid && @invalid_text %>
      <div class="cds--form-requirement"><%= @invalid_text %></div>
    <% end %>
  </div>
</div>
