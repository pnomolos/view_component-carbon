<div class="<%= wrapper_classes %>">
  <div class="<%= number_classes %>" <%= tag.attributes(data_invalid_attrs) %> data-controller="carbon--number-input">
    <% if @label_text %>
      <label for="<%= @id %>" class="cds--label<%= ' cds--label--disabled' if @disabled %>"><%= @label_text %></label>
    <% end %>
    <div class="<%= input_wrapper_classes %>">
      <input <%= tag.attributes(input_attributes) %>
             data-carbon--number-input-target="input">
      <%= warning_icon_svg&.html_safe %>
    </div>
    <% unless @hide_steppers %>
      <div class="cds--number__controls">
        <button <%= tag.attributes(button_attributes('down')) %>
                data-action="click->carbon--number-input#decrement"><%= subtract_icon_svg.html_safe %></button>
        <div class="cds--number__rule-divider"></div>
        <button <%= tag.attributes(button_attributes('up')) %>
                data-action="click->carbon--number-input#increment"><%= add_icon_svg.html_safe %></button>
        <div class="cds--number__rule-divider"></div>
      </div>
    <% end %>
    <% if @helper_text && !@invalid && !@warn %>
      <div class="cds--form__helper-text<%= ' cds--form__helper-text--disabled' if @disabled %>" id="<%= aria_describedby_id %>"><%= @helper_text %></div>
    <% end %>
    <% if @invalid && @invalid_text %>
      <div class="cds--form-requirement" id="<%= aria_describedby_id %>"><%= @invalid_text %></div>
    <% end %>
    <% if @warn && @warn_text %>
      <div class="cds--form-requirement" id="<%= aria_describedby_id %>"><%= @warn_text %></div>
    <% end %>
  </div>
</div>
