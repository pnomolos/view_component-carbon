<div style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: center;">
  <%= render Carbon::ButtonComponent.new(kind: :primary) do %>Primary<% end %>
  <%= render Carbon::ButtonComponent.new(kind: :secondary) do %>Secondary<% end %>
  <%= render Carbon::ButtonComponent.new(kind: :tertiary) do %>Tertiary<% end %>
  <%= render Carbon::ButtonComponent.new(kind: :ghost) do %>Ghost<% end %>
  <%= render Carbon::ButtonComponent.new(kind: :danger) do %>Danger<% end %>
  <%= render Carbon::ButtonComponent.new(kind: :danger_tertiary) do %>Danger Tertiary<% end %>
  <%= render Carbon::ButtonComponent.new(kind: :danger_ghost) do %>Danger Ghost<% end %>
</div>
